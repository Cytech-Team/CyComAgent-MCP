+#[derive(Clone, Copy, Debug, Serialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+enum KwinGeometryChange {
+    Move { x: i32, y: i32 },
+    Resize { width: i32, height: i32 },
+}
+
+impl KwinGeometryChange {
+    fn validate(self) -> Result<()> {
+        if let Self::Resize { width, height } = self {
+            if width <= 0 || height <= 0 {
+                bail!("KWin window width and height must be positive");
+            }
+        }
+        Ok(())
+    }
+
+    fn matches(self, bounds: &WindowBounds) -> bool {
+        match self {
+            Self::Move { x, y } => bounds.x == Some(x) && bounds.y == Some(y),
+            Self::Resize { width, height } => {
+                bounds.width == width as u32 && bounds.height == height as u32
+            }
+        }
+    }
+}
+
+pub async fn move_window(window_id: u64, x: i32, y: i32) -> Result<String> {
+    change_window_geometry(window_id, KwinGeometryChange::Move { x, y }).await
+}
+
+pub async fn resize_window(window_id: u64, width: i32, height: i32) -> Result<String> {
+    change_window_geometry(window_id, KwinGeometryChange::Resize { width, height }).await
+}
+
+async fn change_window_geometry(window_id: u64, change: KwinGeometryChange) -> Result<String> {
+    change.validate()?;
+    let uuid = kwin_uuid_for_window_id(window_id).await?.with_context(|| {
+        format!("No KWin window matched window_id {window_id} during geometry change")
+    })?;
+    let json = call_kwin_script(move |service_name, object_path, plugin_name| {
+        let script =
+            kwin_geometry_script_source(service_name, object_path, plugin_name, &uuid, change)?;
+        write_kwin_script_file(plugin_name, &script)
+    })
+    .await?;
+    let result: KwinScriptResult =
+        serde_json::from_str(&json).context("failed to parse KWin geometry script output")?;
+    if !result.ok {
+        bail!(
+            "KWin geometry change refused: {}",
+            result.error.unwrap_or_else(|| "unknown error".into())
+        );
+    }
+    // Wayland clients acknowledge resize requests asynchronously. A successful
+    // script callback alone is not evidence that the geometry reached the app.
+    let mut last_bounds = None;
+    for _ in 0..12 {
+        let window = list_windows()
+            .await?
+            .into_iter()
+            .find(|window| window.window_id == window_id)
+            .context("KWin target window disappeared during geometry verification")?;
+        if let Some(bounds) = window.bounds {
+            if change.matches(&bounds) {
+                return Ok(format!(
+                    "Window geometry changed through KWin and verified: {},{} {}x{}.",
+                    bounds.x.unwrap_or_default(),
+                    bounds.y.unwrap_or_default(),
+                    bounds.width,
+                    bounds.height
+                ));
+            }
+            last_bounds = Some(bounds);
+        }
+        sleep(Duration::from_millis(60)).await;
+    }
+    bail!("KWin did not reach requested geometry {change:?}; actual bounds: {last_bounds:?}. The application or window rules may constrain its geometry.")
+}
+
+fn kwin_geometry_script_source(
+    service_name: &str,
+    object_path: &str,
+    plugin_name: &str,
+    uuid: &str,
+    change: KwinGeometryChange,
+) -> Result<String> {
+    change.validate()?;
+    let uuid = normalize_kwin_uuid(uuid).context("KWin geometry change requires a uuid")?;
+    let service_name = serde_json::to_string(service_name)?;
+    let object_path = serde_json::to_string(object_path)?;
+    let interface = serde_json::to_string(KWIN_CALLBACK_INTERFACE)?;
+    let plugin_name = serde_json::to_string(plugin_name)?;
+    let uuid = serde_json::to_string(&uuid)?;
+    let change = serde_json::to_string(&change)?;
+    Ok(format!(
+        r#"(function() {{
+    var targetUuid = {uuid};
+    var change = {change};
+    function send(payload) {{
+        payload.backend = "kwin";
+        payload.pluginName = {plugin_name};
+        callDBus({service_name}, {object_path}, {interface}, "ReceiveResult", JSON.stringify(payload));
+    }}
+    function normalizeUuid(value) {{
+        if (value === null || value === undefined) return "";
+        return String(value).trim().toLowerCase().replace(/^\{{|\}}$/g, "");
+    }}
+    try {{
+        var windows = typeof workspace.windowList === "function" ? workspace.windowList()
+            : (typeof workspace.clientList === "function" ? workspace.clientList() : workspace.stackingOrder);
+        var target = null;
+        for (var i = 0; windows && i < windows.length; i++) {{
+            if ((normalizeUuid(windows[i].uuid) || normalizeUuid(windows[i].internalId)) === targetUuid) {{
+                target = windows[i];
+                break;
+            }}
+        }}
+        if (!target) throw new Error("window not found: " + targetUuid);
+        if (target.fullScreen) throw new Error("leave fullscreen before changing window geometry");
+        if (change.kind === "move" && target.moveable === false) throw new Error("window is not moveable");
+        if (change.kind === "resize" && target.resizeable === false) throw new Error("window is not resizeable");
+        if (typeof target.setMaximize === "function") target.setMaximize(false, false);
+        var current = target.moveResizeGeometry || target.frameGeometry;
+        if (!current || !(current.width > 0) || !(current.height > 0)) throw new Error("window has no usable frame geometry");
+        // KWin exposes QRectF as a Qt value wrapper: writing its fields may be
+        // ignored. Assign a fresh plain object to frameGeometry instead.
+        var rect = {{x: current.x, y: current.y, width: current.width, height: current.height}};
+        if (change.kind === "move") {{
+            rect.x = change.x;
+            rect.y = change.y;
+        }} else {{
+            rect.width = change.width;
+            rect.height = change.height;
+        }}
+        target.frameGeometry = rect;
+        send({{ok: true}});
+    }} catch (error) {{
+        send({{ok: false, error: String(error && error.message ? error.message : error)}});
+    }}
+}})();
+"#
+    ))
+}
