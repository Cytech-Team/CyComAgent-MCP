+#[cfg(test)]
+mod geometry_tests {
+    use super::*;
+
+    fn script(change: KwinGeometryChange) -> Result<String> {
+        kwin_geometry_script_source(":1.234", "/test", "test", "{ABC-123}", change)
+    }
+
+    #[test]
+    fn geometry_move_uses_native_kwin_and_supports_negative_coordinates() {
+        let js = script(KwinGeometryChange::Move { x: -1920, y: 120 }).unwrap();
+        assert!(js.contains(r#"var targetUuid = "abc-123";"#));
+        assert!(js.contains(r#""kind":"move","x":-1920,"y":120"#));
+        assert!(js.contains("workspace.windowList()"));
+        assert!(js.contains("workspace.clientList()"));
+        assert!(js.contains("target.frameGeometry = rect"));
+        assert!(!js.contains("xdotool"));
+    }
+
+    #[test]
+    fn geometry_resize_unmaximizes_and_checks_window_capabilities() {
+        let js = script(KwinGeometryChange::Resize {
+            width: 900,
+            height: 700,
+        })
+        .unwrap();
+        assert!(js.contains("target.setMaximize(false, false)"));
+        assert!(js.contains("target.resizeable === false"));
+        assert!(js.contains("if (target.fullScreen)"));
+        assert!(js.contains("ReceiveResult"));
+    }
+
+    #[test]
+    fn geometry_rejects_nonpositive_dimensions_before_dbus() {
+        for (width, height) in [(0, 10), (10, 0), (-1, 10), (10, -1)] {
+            assert!(script(KwinGeometryChange::Resize { width, height }).is_err());
+        }
+    }
+
+    #[test]
+    fn geometry_verification_checks_requested_axis_and_size() {
+        let b = WindowBounds {
+            x: Some(-1920),
+            y: Some(120),
+            width: 900,
+            height: 700,
+        };
+        assert!(KwinGeometryChange::Move { x: -1920, y: 120 }.matches(&b));
+        assert!(!KwinGeometryChange::Move { x: 0, y: 120 }.matches(&b));
+        assert!(KwinGeometryChange::Resize {
+            width: 900,
+            height: 700
+        }
+        .matches(&b));
+        assert!(!KwinGeometryChange::Resize {
+            width: 901,
+            height: 700
+        }
+        .matches(&b));
+    }
+
+    #[test]
+    fn geometry_clones_qt_rectangle_before_mutating_fields() {
+        let js = script(KwinGeometryChange::Move { x: 100, y: 200 }).unwrap();
+        assert!(js.contains(
+            "var rect = {x: current.x, y: current.y, width: current.width, height: current.height}"
+        ));
+        assert!(!js.contains("var rect = target.frameGeometry"));
+    }
+
+    #[test]
+    fn geometry_script_escapes_callback_names() {
+        let js = kwin_geometry_script_source(
+            "quote\"name",
+            "/test",
+            "test",
+            "abc",
+            KwinGeometryChange::Move { x: 0, y: 0 },
+        )
+        .unwrap();
+        assert!(js.contains(r#"quote\"name"#));
+    }
+}
